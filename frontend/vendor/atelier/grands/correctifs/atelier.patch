+                [require.resolve('scratch-parser/lib/validate.js')]: foyerGenerated('validate.js'),
+                'scratch-l10n/locales/editor-msgs$': foyerGenerated('editor-msgs.js'),
+                'scratch-l10n/locales/paint-editor-msgs$': foyerGenerated('paint-editor-msgs.js')
