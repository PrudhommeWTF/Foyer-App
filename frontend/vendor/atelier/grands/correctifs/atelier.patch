diff --git a/packages/scratch-gui/webpack.config.js b/packages/scratch-gui/webpack.config.js
index b97bc1c..3f026fa 100644
--- a/packages/scratch-gui/webpack.config.js
+++ b/packages/scratch-gui/webpack.config.js
@@ -235,8 +235,45 @@ const buildConfig = baseConfig.clone()
 // `BUILD_MODE=dist npm run build`
 const buildDist = process.env.NODE_ENV === 'production' || process.env.BUILD_MODE === 'dist';
 
+// Atelier (Foyer): the only build Foyer uses. One page (editor.html), one bundle,
+// French and English messages only, and the project validators precompiled so
+// that nothing generates code at run time (the page is served under a strict
+// Content-Security-Policy, without 'unsafe-eval'). The generated modules are
+// written by the tools of frontend/vendor/atelier/grands/outils before this runs.
+const foyerGenerated = name => path.resolve(__dirname, 'src/foyer/generated', name);
+const foyerConfig = baseConfig.clone()
+    .merge({
+        entry: {
+            atelier: './src/foyer/index.jsx'
+        },
+        output: {
+            path: path.resolve(__dirname, 'dist-foyer'),
+            publicPath: '',
+            library: {
+                name: 'Atelier',
+                type: 'umd2'
+            }
+        },
+        devtool: false
+    })
+    .addPlugin(new HtmlWebpackPlugin({
+        chunks: ['atelier'],
+        filename: 'editor.html',
+        template: 'src/foyer/editor.ejs'
+    }))
+    .addPlugin(new webpack.NormalModuleReplacementPlugin(
+        /scratch-parser[\\/]lib[\\/]validate\.js$/, foyerGenerated('validate.js')
+    ))
+    .addPlugin(new webpack.NormalModuleReplacementPlugin(
+        /scratch-l10n[\\/]locales[\\/]editor-msgs(\.js)?$/, foyerGenerated('editor-msgs.js')
+    ))
+    .addPlugin(new webpack.NormalModuleReplacementPlugin(
+        /scratch-l10n[\\/]locales[\\/]paint-editor-msgs(\.js)?$/, foyerGenerated('paint-editor-msgs.js')
+    ));
+
 let config;
 switch (process.env.BUILD_TYPE) {
+case 'foyer': config = foyerConfig.get(); break;
 case 'dist': config = distConfig.get(); break;
 case 'dist-standalone': config = distStandaloneConfig.get(); break;
 default: config = buildConfig.get(); break;
