 "recipeInstructions": [
  { "@type": "HowToStep", "text": "Emincer les oignons." },
  { "@type": "HowToStep", "text": "Les faire fondre dans le beurre." },
  { "@type": "HowToStep", "text": "Râper 4 courgettes avec leur peau." },
  { "@type": "HowToStep", "text": "Les ajouter aux oignons." },
  { "@type": "HowToStep", "text": "Préchauffer le four à 200°C (thermostat 6-7)." },
  { "@type": "HowToStep", "text": "Mélanger le gruyère râpé, les oeufs, la crème fraîche, puis saler et poivrer." },
  { "@type": "HowToStep", "text": "Mettre les courgettes dans un plat et verser par dessus la sauce et faire à four chaud pendant 15 min." }
 ],
