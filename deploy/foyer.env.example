# Configuration de Foyer, à copier en « foyer.env » à côté de l'application
# (ou dans /etc/foyer/foyer.env) et à charger avant « node dist/server.js »,
# par exemple avec EnvironmentFile= dans une unité systemd.
# Ne versionnez jamais le fichier rempli : il porte des secrets.

# OBLIGATOIRE en production (16 caractères au moins), sinon le service refuse
# de démarrer. Le changer déconnecte tout le monde.
#   openssl rand -hex 32
FOYER_JWT_SECRET=

# Clé de chiffrement des identifiants ÉcoleDirecte enregistrés (module École).
# Générée une fois, jamais remplacée : la perdre oblige à les ressaisir.
# Sauvegardez-la avec la base.
#   openssl rand -base64 32
FOYER_SECRET_KEY=

NODE_ENV=production

# Où vivent la base SQLite et les pièces jointes (à sauvegarder).
FOYER_DATA_DIR=/var/lib/foyer

# Port et interface d'écoute. 127.0.0.1 quand un reverse-proxy tourne sur la
# même machine ; sinon, filtrez le port au pare-feu.
PORT=8099
FOYER_BIND=127.0.0.1

# Sans reverse-proxy devant le service, aucun en-tête X-Forwarded-For n'est à
# croire : décommentez.
# FOYER_TRUST_PROXY=false

# Adresse publique du foyer (notifications, connecteurs d'assistants).
# Peut aussi se renseigner dans Paramètres.
# FOYER_PUBLIC_URL=

# La version affichée est inscrite dans le package.json de l'archive : inutile
# de poser FOYER_VERSION.
